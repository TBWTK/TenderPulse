# Safe template only. Copy to .env; never commit real values.
DATABASE_URL=postgresql+psycopg://tenderpulse:tenderpulse-local-only@db:5432/tenderpulse
RAW_STORE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=tenderpulse-local
S3_SECRET_KEY=tenderpulse-local-only
S3_BUCKET=tenderpulse-raw

GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE_FILE=/app/certs/russian_trusted_root_ca_pem.crt
EIS_ROOT_CA_FILE=/app/certs/russian_trusted_root_ca_pem.crt
EIS_SUB_CA_FILE=/app/certs/russian_trusted_sub_ca_pem.crt
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1

LIVE_INGESTION_ENABLED=false
INGESTION_INTERVAL_SECONDS=3600
SOURCE_RECORD_LIMIT=25
EIS_LOOKBACK_DAYS=7

# Optional. HTTPS only; unset means no external delivery.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=10
ALERT_WEBHOOK_MAX_ATTEMPTS=5
TENDERPULSE_PORT=8010
TENDERPULSE_DB_PORT=5433
TENDERPULSE_MINIO_CONSOLE_PORT=9001
